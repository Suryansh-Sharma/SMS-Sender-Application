{
  "name": "nps-communication-manager",
  "productName": "NPS Communication Manager",
  "description": "School Communication and Bulk SMS Management Application for Notices, Alerts, Reports and Parent Communication.",
  "author": "Suryansh Sharma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --disable-gpu --ozone-platform=x11\"",
    "start": "cross-env ELECTRON_ENABLE_LOGGING=true electron . --disable-gpu --ozone-platform=x11",
    "lint": "eslint .",
    "preview": "vite preview",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.nps.communicationmanager",
    "productName": "NPS Communication Manager",
    "copyright": "Copyright © 2026 NPS Communication Manager",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/nps-bg-removed.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NPS Communication Manager",
      "installerIcon": "build/nps-bg-removed.ico",
      "uninstallerIcon": "build/nps-bg-removed.ico",
      "installerHeaderIcon": "build/nps-bg-removed.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@tailwindcss/vite": "^4.2.2",
    "antd": "^6.3.6",
    "apexcharts": "^5.12.0",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.9.0",
    "react": "^19.2.4",
    "react-apexcharts": "^2.1.0",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.2",
    "tailwindcss": "^4.2.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  }
}
